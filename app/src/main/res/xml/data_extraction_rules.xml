<?xml version="1.0" encoding="utf-8"?>
<!-- بيانات التلاميذ لا تُنسخ احتياطياً إلى السحابة ولا تُنقل إلى جهاز آخر -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
